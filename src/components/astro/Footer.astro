---
// src/components/astro/Footer.astro
import { useTranslations } from '../../i18n/utils';
import { ui } from '../../i18n/ui';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#1A1C29] text-gray-300 pt-16 pb-8 border-t-4 border-titacosi-accent">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Grid de Columnas -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-16 py-16">
      
      <!-- Columna 1: Info Brand -->
      <div class="space-y-4">
        <h4 class="text-white text-[12px] font-bold uppercase tracking-[0.2em]">Taberna Tita Cosi</h4>
        <p class="text-sm leading-relaxed text-gray-400">
          {t('footer.desc')}
        </p>
        <div class="pt-4 space-y-3 text-sm">
          <p class="flex items-center gap-2">
            <span>📍</span> Av. del Editor Ángel Caffarena, 13, Málaga
          </p>
          <p class="flex items-center gap-2">
            <span>📞</span> +34 667 94 02 60
          </p>
          <p class="flex items-center gap-2">
            <span>✉️</span> hola@tabernatitacosi.es
          </p>
        </div>
      </div>

      <!-- Columna 2: Horarios -->
      <div class="space-y-4">
        <h4 class="text-white text-[12px] font-bold uppercase tracking-[0.2em]">{t('footer.horarios')}</h4>
        <ul class="space-y-3 text-sm text-gray-400">
          <li class="flex justify-between"><span>Mar - Jue:</span> <span>13:00 - 16:30 | 20:00 - 23:30</span></li>
          <li class="flex justify-between"><span>Vie - Sáb:</span> <span>13:00 - 00:00</span></li>
          <li class="flex justify-between"><span>Dom:</span> <span>13:00 - 17:00</span></li>
          <li class="flex justify-between text-titacosi-accent"><span>Lun:</span> <span>Cerrado</span></li>
        </ul>
      </div>

      <!-- Columna 3: Enlaces -->
      <div class="space-y-4">
        <h4 class="text-white text-[12px] font-bold uppercase tracking-[0.2em]">{t('footer.enlaces')}</h4>
        <ul class="space-y-3 text-sm">
          <li><a href={`/${lang}`} class="hover:text-white transition-colors">{t('nav.inicio')}</a></li>
          <li><a href={`/${lang}/carta`} class="hover:text-white transition-colors">{t('nav.carta')}</a></li>
          <li><a href={`/${lang}/reservas`} class="hover:text-white transition-colors">{t('nav.reservar')}</a></li>
          <li><a href={`/${lang}/contacto`} class="hover:text-white transition-colors">{t('nav.contacto')}</a></li>
        </ul>
      </div>

      <!-- Columna 4: Legal -->
      <div class="space-y-4">
        <h4 class="text-white text-[12px] font-bold uppercase tracking-[0.2em]">{t('footer.legal')}</h4>
        <ul class="space-y-3 text-sm">
          <li><a href={`/${lang}/privacidad`} class="hover:text-white transition-colors">{t('footer.privacidad')}</a></li>
          <li><a href={`/${lang}/cookies`} class="hover:text-white transition-colors">{t('footer.cookies')}</a></li>
          <li><a href={`/${lang}/terminos`} class="hover:text-white transition-colors">{t('footer.terminos')}</a></li>
        </ul>
      </div>

    </div>

    <!-- Divider -->
    <div class="border-t border-gray-700/50 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-gray-500">
        &copy; {currentYear} Taberna Tita Cosi. {t('footer.derechos')}
      </p>
      
<!-- Redes Sociales -->
      <div class="flex space-x-6">
        <!-- Instagram -->
        <a href="https://www.instagram.com/titacositaberna/" class="text-gray-400 hover:text-white transition-colors" aria-label="Instagram">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
          </svg>
        </a>

        <!-- WhatsApp -->
        <a href="tel:+34667940260" class="text-gray-400 hover:text-white transition-colors" aria-label="WhatsApp">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </a>
      </div>
</footer>