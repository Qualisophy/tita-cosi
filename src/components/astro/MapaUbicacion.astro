---
// src/components/astro/MapaUbicacion.astro

export interface Props {
  titulo: string;
  direccion: string;
  mapaUrl: string;
}

const { titulo, direccion, mapaUrl } = Astro.props;
---

<section class="w-full max-w-6xl mx-auto px-4">
  <div class="mb-8 text-center">
    <h2 class="text-3xl font-bold text-neutral-900">{titulo}</h2>
    <p class="text-neutral-600 mt-2">{direccion}</p>
  </div>

  <div class="relative w-full overflow-hidden rounded-2xl shadow-md bg-neutral-200 aspect-video md:aspect-[21/9] flex items-center justify-center border border-neutral-300">
    
    <iframe 
      src={mapaUrl} 
      width="100%" 
      height="100%" 
      style="border:0;" 
      allowfullscreen="" 
      loading="lazy" 
      referrerpolicy="no-referrer-when-downgrade"
      class="absolute inset-0 w-full h-full"
      title={`Mapa de ubicación de ${titulo}`}
    ></iframe>
    
  </div>
</section>