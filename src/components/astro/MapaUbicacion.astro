---
// src/components/astro/MapaUbicacion.astro
---

<section class="w-full max-w-6xl mx-auto px-4 py-12">
  <div class="mb-8 text-center">
    <h2 class="text-3xl font-bold text-neutral-900">Nuestra Ubicación</h2>
    <p class="text-neutral-600 mt-2">Av. del Editor Ángel Caffarena, 13, Teatinos, 29010 Málaga.</p>
  </div>

  <div class="relative w-full overflow-hidden rounded-2xl shadow-md bg-neutral-200 aspect-video md:aspect-[21/9] flex items-center justify-center border border-neutral-300">
    
    <iframe 
      src="https://maps.google.com/maps?q=Tita+Cosi+Taberna,+Av.+del+Editor+%C3%81ngel+Caffarena,+13,+M%C3%A1laga&t=&z=16&ie=UTF8&iwloc=&output=embed" 
      width="100%" 
      height="100%" 
      style="border:0;" 
      allowfullscreen="" 
      loading="lazy" 
      referrerpolicy="no-referrer-when-downgrade"
      class="absolute inset-0 w-full h-full"
      title="Mapa de ubicación de Taberna Tita Cosi"
    ></iframe>
    
  </div>
</section>