---
// src/pages/[lang]/admin.astro
import LayoutAdmin from "../../layouts/LayoutAdmin.astro";
import AdminDashboard from "../../components/react/admin/AdminDashboard.tsx";
import { getLangFromUrl } from "../../i18n/utils";

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } }
  ];
}

const lang = getLangFromUrl(Astro.url);
---

<LayoutAdmin title="Panel de Gestión - Tita Cosi" lang={lang}>
  <AdminDashboard lang={lang} client:load />
</LayoutAdmin>