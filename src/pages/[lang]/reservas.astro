---
// src/pages/[lang]/reservas.astro
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { languages } from '../../i18n/ui';
import ReservationWidget from '../../components/react/reservas/ReservationWidget';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);


---

<Layout title="Reservas - Taberna Tita Cosi" lang={lang}>
  <main class="flex-grow w-full max-w-container-max mx-auto px-4 md:px-16 py-12 md:py-24">
    {/* Montamos el componente de React. client:load es vital para que la interactividad funcione al instante */}
    <ReservationWidget client:load lang={lang} />
  </main>
</Layout>