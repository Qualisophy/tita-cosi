---
// src/pages/[lang]/login.astro
import LayoutAdmin from "../../layouts/LayoutAdmin.astro";
import AdminLogin from "../../components/react/admin/AdminLogin.tsx";
import { getLangFromUrl } from "../../i18n/utils";

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } }
  ];
}

const lang = getLangFromUrl(Astro.url);
---

<LayoutAdmin title="Acceso CRM - Tita Cosi" lang={lang}>
  <AdminLogin lang={lang} client:load />
</LayoutAdmin>