---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { languages } from '../../i18n/ui';

// Esta es la función que Astro te está pidiendo a gritos
export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('cookies.titulo')} lang={lang}>
  <div class="w-full">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-8 flex flex-col items-center justify-center">
      <h1 class="font-serif text-4xl text-titacosi-primary">{t('cookies.titulo')}</h1>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 flex flex-col">
      <p class="font-serif mb-4 leading-relaxed text-titacosi-primary text-justify">{t('cookies.texto.1')}</p>
      <p class="font-serif mb-4 leading-relaxed text-titacosi-primary text-justify">{t('cookies.texto.2')}</p>

      <h2 class="font-serif text-2xl mt-10 mb-4 text-titacosi-primary">{t('cookies.1.titulo')}</h2>
      <p class="font-serif mb-4 leading-relaxed text-titacosi-primary text-justify">{t('cookies.1.texto')}</p>

      <h2 class="font-serif text-2xl mt-10 mb-4 text-titacosi-primary">{t('cookies.2.titulo')}</h2>
      <p class="font-serif mb-4 leading-relaxed text-titacosi-primary text-justify">{t('cookies.2.texto')}</p>
      <ul class="list-disc list-outside ml-9 space-y-4 leading-relaxed text-titacosi-primary text-justify">
        <li>{t('cookies.2.1.texto')}</li>
        <li>{t('cookies.2.2.texto')}</li>
        <li>{t('cookies.2.3.texto')}</li>
        <li>{t('cookies.2.4.texto')}</li>
      </ul>           

      <h2 class="font-serif text-2xl mt-10 mb-4 text-titacosi-primary">{t('cookies.3.titulo')}</h2>

      <div class="overflow-x-auto my-8 rounded-xl border border-neutral-200 shadow-sm">
        <table class="w-full text-left border-collapse bg-white">
          <thead>
            <tr class="bg-neutral-50 border-b border-neutral-200">
              <th class="px-6 py-4 text-sm font-bold text-titacosi-primary uppercase tracking-wider">{t('cookies.3.tipo.titulo')}</th>
              <th class="px-6 py-4 text-sm font-bold text-titacosi-primary uppercase tracking-wider">{t('cookies.3.proveedor.titulo')}</th>
              <th class="px-6 py-4 text-sm font-bold text-titacosi-primary uppercase tracking-wider">{t('cookies.3.finalidad.titulo')}</th>
              <th class="px-6 py-4 text-sm font-bold text-titacosi-primary uppercase tracking-wider">{t('cookies.3.duracion.titulo')}</th>
            </tr>
          </thead>
          
          <tbody class="divide-y divide-neutral-200 text-neutral-700">
            <tr class="hover:bg-neutral-50 transition-colors">
              <td class="px-6 py-4 text-sm font-medium">{t('cookies.3.tipo.1')}</td>
              <td class="px-6 py-4 text-sm">{t('cookies.3.proveedor.1')}</td>
              <td class="px-6 py-4 text-sm leading-relaxed">{t('cookies.3.finalidad.1')}</td>
              <td class="px-6 py-4 text-sm whitespace-nowrap">{t('cookies.3.duracion.1')}</td>
            </tr>
            
            <tr class="hover:bg-neutral-50 transition-colors">
              <td class="px-6 py-4 text-sm font-medium">{t('cookies.3.tipo.2')}</td>
              <td class="px-6 py-4 text-sm">{t('cookies.3.proveedor.2')}</td>
              <td class="px-6 py-4 text-sm leading-relaxed">{t('cookies.3.finalidad.2')}</td>
              <td class="px-6 py-4 text-sm whitespace-nowrap">{t('cookies.3.duracion.2')}</td>
            </tr>

            <tr class="hover:bg-neutral-50 transition-colors">
              <td class="px-6 py-4 text-sm font-medium">{t('cookies.3.tipo.3')}</td>
              <td class="px-6 py-4 text-sm">{t('cookies.3.proveedor.3')}</td>
              <td class="px-6 py-4 text-sm leading-relaxed">{t('cookies.3.finalidad.3')}</td>
              <td class="px-6 py-4 text-sm whitespace-nowrap">{t('cookies.3.duracion.3')}</td>
            </tr>            
          </tbody>
        </table>
      </div>

      <h2 class="font-serif text-2xl mt-10 mb-4 text-titacosi-primary">{t('cookies.4.titulo')}</h2>
      <p class="font-serif mb-4 leading-relaxed text-titacosi-primary text-justify">{t('cookies.4.texto.1')}</p>
      <p class="font-serif mb-4 leading-relaxed text-titacosi-primary text-justify">{t('cookies.4.texto.2')}</p>
      <ul class="list-disc list-outside ml-9 space-y-4 leading-relaxed text-titacosi-primary text-justify">
        <li>{t('cookies.4.1.texto')}</li>
        <li>{t('cookies.4.2.texto')}</li>
        <li>{t('cookies.4.3.texto')}</li>
        <li>{t('cookies.4.4.texto')}</li>
      </ul>
      <i class="font-serif mb-4 mt-4 leading-relaxed text-titacosi-primary text-justify">{t('cookies.4.texto.3')}</i>

      <h2 class="font-serif text-2xl mt-10 mb-4 text-titacosi-primary">{t('cookies.5.titulo')}</h2>
      <p class="font-serif mb-4 leading-relaxed text-titacosi-primary text-justify">{t('cookies.5.texto')}</p>
 
      <h2 class="font-serif text-2xl mt-10 mb-4 text-titacosi-primary">{t('cookies.6.titulo')}</h2>
      <p class="font-serif mb-4 leading-relaxed text-titacosi-primary text-justify">{t('cookies.6.texto')}</p>
    </div>
  </div>
</Layout>