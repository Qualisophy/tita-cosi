---
// src/pages/[lang]/carta.astro
import Layout from '../../layouts/Layout.astro';
import Menu from '../../components/react/carta/Menu';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { languages } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="Nuestra Carta" lang={lang}>
  
  {/* Hero Sencillo para la Carta */}
  <section class="w-full bg-titacosi-surface py-20 md:py-32 flex items-center justify-center border-b border-titacosi-primary/10">
    <div class="text-center px-4">
      <p class="text-sm font-bold uppercase tracking-widest text-titacosi-accent mb-4">Descubre nuestros sabores</p>
      <h1 class="font-serif font-black italic text-5xl md:text-7xl text-titacosi-primary drop-shadow-sm">
        Nuestra Carta
      </h1>
    </div>
  </section>

  {/* Componente React Interactivo */}
  <section class="min-h-screen bg-titacosi-base">
    <Menu currentLang={lang} client:load />
  </section>

</Layout>