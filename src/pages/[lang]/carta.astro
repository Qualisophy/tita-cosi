---
import Layout from '../../layouts/Layout.astro';
import Menu from '../../components/react/carta/Menu';
import HeroCarta from '../../components/react/carta/HeroCarta';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { languages } from '../../i18n/ui';
import banner2 from '../../assets/banner-2.webp';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('carta.title')} lang={lang}>
  
  {/* Hero Dinámico para la Carta (React + GSAP) */}
  <HeroCarta currentLang={lang} backgroundImage={banner2} client:load />

  {/* Componente React Interactivo (Catálogo de Platos) */}
  <section class="min-h-screen bg-titacosi-base">
    <Menu currentLang={lang} client:load />
  </section>

</Layout>