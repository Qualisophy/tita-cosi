---
// src/pages/[lang]/index.astro
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/react/home/Hero';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { languages } from '../../i18n/ui';
import ServiciosCarta from '../../components/react/home/ServiciosCarta';
// 1. Importamos Astro assets para optimización automática
import { Image } from 'astro:assets';
import bannerImg from '../../assets/banner.jpg'; // Astro sabrá que esta es para procesar
import imgCroquetas from '../../assets/croquetas.png';
import imgTostas from '../../assets/tosta.png';
import imgCarnes from '../../assets/carne.png';
import QuienesSomos from '../../components/react/home/QuienesSomos';
import QueHacemos from '../../components/react/home/QueHacemos';
export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="Inicio | Taberna Moderna" lang={lang}>
  
  <div class="flex flex-col">
    
    <Hero currentLang={lang} backgroundImage={bannerImg} client:load />

    {/* Sección 2: Quiénes Somos (React) */}
    <QuienesSomos currentLang={lang} />

    {/* Sección 3: Qué Hacemos (React) */}
    <QueHacemos currentLang={lang} />

   <ServiciosCarta 
      currentLang={lang} 
      image1={imgCroquetas.src}
      image2={imgTostas.src}
      image3={imgCarnes.src}
    />

  </div>
</Layout>