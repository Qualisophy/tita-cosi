---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { languages } from '../../i18n/ui';
import MapaUbicacion from '../../components/astro/MapaUbicacion.astro';
import ContactForm from '../../components/react/contacto/ContactForm';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const formTranslations = {
  nameLabel: t('contacto.formulario.nombres.titulo'),
  namePlaceholder: t('contacto.formulario.nombres.textoAyuda'),
  emailLabel: t('contacto.formulario.email.titulo'),
  emailPlaceholder: t('contacto.formulario.email.textoAyuda'),
  phoneLabel: t('contacto.formulario.telefono.titulo'),
  phonePlaceholder: t('contacto.formulario.telefono.textoAyuda'),
  messageLabel: t('contacto.formulario.mensaje.titulo'),
  messagePlaceholder: t('contacto.formulario.mensaje.textoAyuda'),
  submitButton: t('contacto.formulario.boton.titulo'),
  successMessage: t('contacto.formulario.success'),
  errorMessage: t('contacto.formulario.error'),
};
---

<Layout title={t('contacto.titulo')} lang={lang}>
  <div class="w-full">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-8 flex flex-col items-center justify-center">
      <h1 class="font-serif text-4xl text-primary">{t('contacto.titulo')}</h1>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-16 grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
    
    <div class="lg:col-span-7 w-full">
      <ContactForm client:load translations={formTranslations} />
    </div>  

    <div class="lg:col-span-5 bg-base border border-gray-200 p-8 sm:p-10 rounded-xl shadow-sm w-full space-y-8 flex flex-col">
      
      <div class="flex items-start gap-4">
        <span class="material-symbols-outlined text-primary text-[28px]">location_on</span>
        <div>
          <h3 class="font-bold text-[13px] text-gray-900 tracking-wider mb-1 uppercase">{t('contacto.direccion.titulo')}</h3>
          <p class="text-[15px] text-gray-700 whitespace-pre-line leading-relaxed">
            {t('contacto.direccion')}
          </p>
        </div>
      </div>
      
      <div class="flex items-start gap-4">
        <span class="material-symbols-outlined text-primary text-[28px]">call</span>
        <div>
          <h3 class="font-bold text-[13px] text-gray-900 tracking-wider mb-1 uppercase">{t('contacto.telefono.titulo')}</h3>
          <p class="text-[15px] text-gray-700">{t('contacto.telefono')}</p>
        </div>
      </div>
      
      <div class="flex items-start gap-4">
        <span class="material-symbols-outlined text-primary text-[28px]">mail</span>
        <div>
          <h3 class="font-bold text-[13px] text-gray-900 tracking-wider mb-1 uppercase">{t('contacto.email.titulo')}</h3>
          <p class="text-[15px] text-gray-700">{t('contacto.email')}</p>
        </div>
      </div>
      
      <div class="flex items-start gap-4">
        <span class="material-symbols-outlined text-primary text-[28px]">schedule</span>
        <div>
          <h3 class="font-bold text-[13px] text-gray-900 tracking-wider mb-1 uppercase">{t('contacto.horario.titulo')}</h3>
          <p class="text-[15px] text-gray-700 whitespace-pre-line leading-relaxed">
            {t('contacto.horario')}
          </p>
        </div>
      </div>

    </div>
  </div>

  <MapaUbicacion 
      titulo={t('contacto.mapa.titulo')}
      direccion="Av. del Editor Ángel Caffarena, 13, Teatinos, 29010 Málaga."
      mapaUrl="https://maps.google.com/maps?q=Tita+Cosi+Taberna,+Av.+del+Editor+%C3%81ngel+Caffarena,+13,+M%C3%A1laga&t=&z=16&ie=UTF8&iwloc=&output=embed"
  />
</Layout>