---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { languages } from '../../i18n/ui';
import MapaUbicacion from '../../components/astro/MapaUbicacion.astro';

// Esta es la función que Astro te está pidiendo a gritos
export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="Página en construcción" lang={lang}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 min-h-[60vh] flex items-center justify-center">
    <h1 class="font-serif text-4xl text-titacosi-primary">Sección en construcción</h1>
  </div>

  <MapaUbicacion 
    titulo="Nuestra Ubicación"
    direccion="Av. del Editor Ángel Caffarena, 13, Teatinos, 29010 Málaga."
    mapaUrl="https://maps.google.com/maps?q=Tita+Cosi+Taberna,+Av.+del+Editor+%C3%81ngel+Caffarena,+13,+M%C3%A1laga&t=&z=16&ie=UTF8&iwloc=&output=embed"
  />
  
</Layout>

