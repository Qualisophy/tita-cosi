---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { languages } from '../../i18n/ui';

// Esta es la función que Astro te está pidiendo a gritos
export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('terms.titulo')} lang={lang}>
  <div class="w-full">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-8 flex flex-col items-center justify-center">
      <h1 class="font-serif text-4xl text-titacosi-primary">{t('terms.titulo')}</h1>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 flex flex-col">
      <h2 class="font-serif text-2xl mt-10 mb-4 text-titacosi-primary">{t('terms.1.titulo')}</h2>
      <ul class="list-disc list-outside ml-9 space-y-4 leading-relaxed text-titacosi-primary text-justify">
        <li>{t('terms.1.1.texto')}</li>
        <li>{t('terms.1.2.texto')}</li>
        <li>{t('terms.1.3.texto')}</li>
      </ul>

      <h2 class="font-serif text-2xl mt-10 mb-4 text-titacosi-primary">{t('terms.2.titulo')}</h2>
      <p class="font-serif mb-4 leading-relaxed text-titacosi-primary text-justify">{t('terms.2.texto')}</p>
      <ul class="list-disc list-outside ml-9 space-y-4 leading-relaxed text-titacosi-primary text-justify">
        <li>{t('terms.2.1.texto')}</li>
        <li>{t('terms.2.2.texto')}</li>
        <li>{t('terms.2.3.texto')}</li>
        <li>{t('terms.2.4.texto')}</li>
      </ul>

      <h2 class="font-serif text-2xl mt-10 mb-4 text-titacosi-primary">{t('terms.3.titulo')}</h2>
      <ul class="list-disc list-outside ml-9 space-y-4 leading-relaxed text-titacosi-primary text-justify">
        <li>{t('terms.3.1.texto')}</li>
        <li>{t('terms.3.2.texto')}</li>
      </ul>

      <h2 class="font-serif text-2xl mt-10 mb-4 text-titacosi-primary">{t('terms.4.titulo')}</h2>
      <ul class="list-disc list-outside ml-9 space-y-4 leading-relaxed text-titacosi-primary text-justify">
        <li>{t('terms.4.1.texto')}</li>
        <li>{t('terms.4.2.texto')}</li>
      </ul>

      <h2 class="font-serif text-2xl mt-10 mb-4 text-titacosi-primary">{t('terms.5.titulo')}</h2>
      <ul class="list-disc list-outside ml-9 space-y-4 leading-relaxed text-titacosi-primary text-justify">
        <li>{t('terms.5.1.texto')}</li>
      </ul>

      <h2 class="font-serif text-2xl mt-10 mb-4 text-titacosi-primary">{t('terms.6.titulo')}</h2>
      <ul class="list-disc list-outside ml-9 space-y-4 leading-relaxed text-titacosi-primary text-justify">
        <li>{t('terms.6.1.texto')}</li>
      </ul>

    </div>
  </div>
</Layout>