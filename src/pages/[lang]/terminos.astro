---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { languages } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="Términos y condiciones" lang={lang}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 min-h-[80vh]">
    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Navegación Legal Sidebar -->
      <aside class="lg:w-48 flex-shrink-0">
        <nav class="sticky top-24">
          <p class="text-xs font-bold uppercase tracking-widest text-on-surface-variant mb-6">Navegación Legal</p>
          <ul class="space-y-4">
            <li>
              <a href="#aviso-legal" class="flex items-center gap-2 text-body-md text-on-surface hover:text-titacosi-accent transition">
                <span class="material-symbols-outlined text-lg"></span>
                Aviso Legal
              </a>
            </li>
            <li>
              <a href="#privacidad" class="flex items-center gap-2 text-body-md text-on-surface hover:text-titacosi-accent transition">
                <span class="material-symbols-outlined text-lg">privacy_tip</span>
                Privacidad
              </a>
            </li>
            <li>
              <a href="#cancelacion" class="flex items-center gap-2 text-body-md text-on-surface hover:text-titacosi-accent transition">
                <span class="material-symbols-outlined text-lg">cancel_schedule_send</span>
                Cancelación
              </a>
            </li>
            <li>
              <a href="#cookies" class="flex items-center gap-2 text-body-md text-on-surface hover:text-titacosi-accent transition">
                <span class="material-symbols-outlined text-lg">security</span>
                Cookies
              </a>
            </li>
          </ul>
        </nav>
      </aside>

      <!-- Contenido Principal -->
      <main class="flex-1 max-w-4xl">
        <!-- Header de Textos Legales -->
        <header class="mb-12">
          <h1 class="font-serif text-4xl md:text-5xl text-primary mb-4">Textos Legales</h1>
          <p class="text-body-lg text-on-surface-variant">
            Información detallada sobre nuestras políticas, privacidad y términos de uso del servicio.
          </p>
          <p class="text-label-sm text-outline-variant mt-4">Última actualización: 24 de Mayo, 2026</p>
        </header>

        <!-- Aviso Legal -->
        <section id="aviso-legal" class="mb-16 scroll-mt-24 bg-white rounded-lg p-8 border border-rounded">
          <h2 class="text-4xl font-bold font-serif">Aviso Legal</h2>
          <div class="space-y-4 text-body-md text-on-surface">
            <p>
              En cumplimiento con el deber de información recogido en artículo 10 de la Ley 34/2002, 
              de 11 de julio de Servicios de la Sociedad de la Información y de Comercio Electrónico 
              (LSSI-CE), el titular de la web le informa de lo siguiente:
            </p>
            <div class="bg-surface-container-low rounded-lg p-6 space-y-3">
              <p><strong>Denominación social:</strong> Taberna Tita Cosi S.L.</p>
              <p><strong>NIF:</strong> N - 0428795</p>
              <p><strong>Domicilio:</strong> Calle Av. del Editor Ángel Caffarena, 13, 29010 Málaga, España</p>
              <p><strong>Registro Mercantil:</strong> Málaga, Tomo XXXX, Folio XX, Sección A, Hoja MA - XXXX</p>
            </div>
            <p>
              Con los límites establecidos en la ley, Taberna Tita Cosi S.L. no asume ninguna 
              responsabilidad derivada de la falta de veracidad, integridad, actualización y precisión 
              de los datos o informaciones que contienen sus páginas web.
            </p>
          </div>
        </section>

        <!-- Política de Privacidad -->
        <section id="privacidad" class="mb-16 scroll-mt-24 bg-white rounded-lg p-8 border border-outline-variant">
          <h2 class="text-4xl font-bold font-serif">Política de Privacidad</h2>
          <div class="space-y-6 text-body-md text-on-surface">
            <div>
              <h3 class="font-sans font-bold text-lg text-primary mb-3">1. Responsable del Tratamiento</h3>
              <p>
                Taberna Tita Cosi S.L. es el responsable del tratamiento de los datos personales del 
                Usuario y la informa que estos datos serán tratados de conformidad con lo dispuesto en 
                el Reglamento (UE) 2016/679 (GDPR).
              </p>
            </div>
            <div>
              <h3 class="font-sans font-bold text-lg text-primary mb-3">2. Finalidad del Tratamiento</h3>
              <p class="mb-3">Mantenemos una relación comercial con el Usuario. Las operaciones previstas son:</p>
              <ul class="list-disc list-inside space-y-2 ml-2">
                <li>Gestión de reservas de mesas en el restaurante.</li>
                <li>Gestión administrativa, contable y fiscal.</li>
                <li>Envío de comunicaciones comerciales bajo consentimiento expreso.</li>
              </ul>
            </div>
            <div>
              <h3 class="font-sans font-bold text-lg text-primary mb-3">3. Derechos del Usuario (GDPR)</h3>
              <ul class="list-disc list-inside space-y-2 ml-2">
                <li>Reiterar el consentimiento en cualquier momento.</li>
                <li>Acceso, rectificación, portabilidad y supresión de sus datos.</li>
                <li>Presentar reclamación ante la autoridad de control (aepd.es).</li>
              </ul>
              <a 
            href="mailto:info@tabornatitacosi.es"
            class="inline-block px-6 py-3 bg-titacosi-accent text-white font-sans font-bold rounded hover:opacity-90 transition"
          >
            Contacto: info@tabernatitacosi.es
          </a>
              
            </div>
          </div>
        </section>

        <!-- Cancelación de Reservas -->
        <section id="cancelacion" class="mb-16 scroll-mt-24 bg-white rounded-lg p-8 border border-outline-variant">
          <h2 class="text-4xl font-bold font-serif">Cancelación de reservas</h2>
          <div clasgarantizar el mejor servicio, aplicamos la siguiente política:</p>
            <div class="grid md:grid-cols-2 gap-6">
              <div class="bg-surface-container-low rounded-lg p-6">
                <div class="flex items-center gap-3 mb-4">
                  <span class="material-symbols-outlined text-titacosi-accent text-2xl">schedule</span>
                  <h3 class="font-sans font-bold text-primary">Estándar</h3>
                </div>
                <p>Cancelaciones con al menos 24 horas de antelación.</p>
              </div>
              <div class="bg-surface-container-low rounded-lg p-6">
                <div class="flex items-center gap-3 mb-4">
                  <span class="material-symbols-outlined text-titacosi-accent text-2xl">group</span>
                  <h3 class="font-sans font-bold text-primary">Grupos (4+)</h3>
                </div>
                <p>Requiere confirmación y 48h de antelación para cancelar.</p>
              </div>
            </div>
            <div class="bg-red-50 border border-red-200 rounded-lg p-4 mt-6">
              <p class="text-red-700">
                <strong>*En caso de "No Show"</strong>, al restaurante se reserva el derecho de limitar futuras reservas.
              </p>
            </div>
          </div>
        </section>

        <!-- Política de Cookies -->
        <section id="cookies" class="mb-16 scroll-mt-24 bg-white rounded-lg p-8 border border-outline-variant">
          <h3 class="text-3xl font-semibold italic font-serif">Política de Cookies</h3>
          <div class="text-base leading-loose">
            <p>
              Utilizamos cookies para mejorar su experiencia de navegación y extender cómo 
              interactúa con nuestro sitio web.
            </p>
            <div class="bg-titacosi-surface p-4 rounded-xl shadow-sm border border-transparent hover:border-titacosi-accent transition-all">
              <h3 class="font-sans font-bold text-primary mb-2">Cookies técnicas</h3>
              <p class="text-on-surface-variant">Necesarias para el funcionamiento básico del sitio.</p>
            </div>
            
            <div class="bg-titacosi-surface p-4 rounded-xl shadow-sm border border-transparent hover:border-titacosi-accent transition-all">
              <h3 class="font-sans font-bold text-primary mb-2">Cookies de análisis</h3>
              <p class="text-on-surface-variant">Nos ayudan a cuantificar el número de usuarios y medir el uso del servicio.</p>
            </div>
            <p class="text-base leading-loose">
              Puede gestionar sus preferencias desde la configuración de su navegador.
            </p>
          </div>
        </section>

        </div>
      </main>
    </div>
  </div>
</Layout>

