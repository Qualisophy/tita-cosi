---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations, languages } from '../../i18n/locales/terminos';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('terms.titulo')} lang={lang}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 pb-12 min-h-[80vh]">
    <div class="flex flex-col lg:flex-row gap-8">
      
      <aside class="lg:w-48 flex-shrink-0 font-sans">
        <nav class="sticky top-32">
          <p class="text-xs font-bold uppercase tracking-widest text-neutral-500 mb-6">Navegación</p>
          <ul class="space-y-4 text-sm">
            <li><a href="#seccion-1" class="text-titacosi-primary hover:text-titacosi-accent transition-colors">{t('terms.1.titulo')}</a></li>
            <li><a href="#seccion-2" class="text-titacosi-primary hover:text-titacosi-accent transition-colors">{t('terms.2.titulo')}</a></li>
            <li><a href="#seccion-3" class="text-titacosi-primary hover:text-titacosi-accent transition-colors">{t('terms.3.titulo')}</a></li>
            <li><a href="#seccion-4" class="text-titacosi-primary hover:text-titacosi-accent transition-colors">{t('terms.4.titulo')}</a></li>
            <li><a href="#seccion-5" class="text-titacosi-primary hover:text-titacosi-accent transition-colors">{t('terms.5.titulo')}</a></li>
            <li><a href="#seccion-6" class="text-titacosi-primary hover:text-titacosi-accent transition-colors">{t('terms.6.titulo')}</a></li>
          </ul>
        </nav>
      </aside>

      <main class="flex-1 max-w-4xl font-sans text-titacosi-primary">
        <header class="mb-12 border-b border-titacosi-surface pb-6">
          <h1 class="font-serif text-4xl md:text-5xl mb-4">{t('terms.titulo')}</h1>
          <p class="text-xs text-neutral-500">Última actualización: 28 de Mayo, 2026</p>
        </header>

        <section id="seccion-1" class="mb-16 scroll-mt-32 bg-white rounded-lg p-8 border border-titacosi-surface">
          <h2 class="text-2xl font-serif mb-4 pb-2 border-b border-titacosi-surface/60">{t('terms.1.titulo')}</h2>
          
          <div class="bg-titacosi-surface p-6 rounded-lg border border-neutral-200">
            <ul class="list-disc list-outside ml-5 space-y-3 text-base leading-loose text-justify">
              <li>{t('terms.1.1.texto')}</li>
              <li>{t('terms.1.2.texto')}</li>
              <li>{t('terms.1.3.texto')}</li>
            </ul>
          </div>
        </section>

        <section id="seccion-2" class="mb-16 scroll-mt-32 bg-white rounded-lg p-8 border border-titacosi-surface">
          <h2 class="text-2xl font-serif mb-4 pb-2 border-b border-titacosi-surface/60">{t('terms.2.titulo')}</h2>
          <p class="text-base leading-loose mb-6 text-justify">{t('terms.2.texto')}</p>
          
          <div class="bg-titacosi-surface p-6 rounded-lg border border-neutral-200">
            <ul class="list-disc list-outside ml-5 space-y-3 text-base leading-loose text-justify">
              <li>{t('terms.2.1.texto')}</li>
              <li>{t('terms.2.2.texto')}</li>
              <li>{t('terms.2.3.texto')}</li>
              <li>{t('terms.2.4.texto')}</li>
            </ul>
          </div>
        </section>

        <section id="seccion-3" class="mb-16 scroll-mt-32 bg-white rounded-lg p-8 border border-titacosi-surface">
          <h2 class="text-2xl font-serif mb-4 pb-2 border-b border-titacosi-surface/60">{t('terms.3.titulo')}</h2>
          
          <div class="bg-titacosi-surface p-6 rounded-lg border border-neutral-200">
            <ul class="list-disc list-outside ml-5 space-y-3 text-base leading-loose text-justify">
              <li>{t('terms.3.1.texto')}</li>
              <li>{t('terms.3.2.texto')}</li>
            </ul>
          </div>
        </section>

        <section id="seccion-4" class="mb-16 scroll-mt-32 bg-white rounded-lg p-8 border border-titacosi-surface">
          <h2 class="text-2xl font-serif mb-4 pb-2 border-b border-titacosi-surface/60">{t('terms.4.titulo')}</h2>
          
          <div class="bg-titacosi-surface p-6 rounded-lg border border-neutral-200">
            <ul class="list-disc list-outside ml-5 space-y-3 text-base leading-loose text-justify">
              <li>{t('terms.4.1.texto')}</li>
              <li>{t('terms.4.2.texto')}</li>
            </ul>
          </div>
        </section>

        <section id="seccion-5" class="mb-16 scroll-mt-32 bg-white rounded-lg p-8 border border-titacosi-surface">
          <h2 class="text-2xl font-serif mb-4 pb-2 border-b border-titacosi-surface/60">{t('terms.5.titulo')}</h2>
          
          <div class="bg-titacosi-surface p-6 rounded-lg border border-neutral-200">
            <ul class="list-disc list-outside ml-5 space-y-3 text-base leading-loose text-justify">
              <li>{t('terms.5.1.texto')}</li>
            </ul>
          </div>
        </section>

        <section id="seccion-6" class="mb-16 scroll-mt-32 bg-white rounded-lg p-8 border border-titacosi-surface">
          <h2 class="text-2xl font-serif mb-4 pb-2 border-b border-titacosi-surface/60">{t('terms.6.titulo')}</h2>
          
          <div class="bg-titacosi-surface p-6 rounded-lg border border-neutral-200">
            <ul class="list-disc list-outside ml-5 space-y-3 text-base leading-loose text-justify">
              <li>{t('terms.6.1.texto')}</li>
            </ul>
          </div>
        </section>

      </main>
    </div>
  </div>
</Layout>