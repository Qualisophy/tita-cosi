---
// src/pages/[lang]/404.astro
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { languages } from '../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('404.title')} lang={lang}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 min-h-[50vh] flex flex-col items-center justify-center text-center">
    <h1 class="font-serif text-8xl md:text-[12rem] text-titacosi-accent font-bold tracking-tighter leading-none mb-6">404</h1>
    <p class="text-titacosi-primary text-xl md:text-2xl max-w-2xl font-medium balance">{t('404.mensaje')}</p>
  </div>
</Layout>