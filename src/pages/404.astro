---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada" lang="es">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 min-h-[60vh] flex flex-col items-center justify-center">
    <h1 class="font-serif text-6xl text-titacosi-accent mb-4">404</h1>
    <p class="text-titacosi-primary">Lo sentimos, esta página no existe.</p>
    <a href="/es" class="mt-8 bg-titacosi-primary text-titacosi-base px-6 py-2 rounded-sm hover:bg-titacosi-accent transition-colors">Volver al inicio</a>
  </div>
</Layout>