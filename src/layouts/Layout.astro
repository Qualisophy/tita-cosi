---
// src/layouts/Layout.astro
import '../styles/global.css';

import Header from '../components/react/shared/Header';
import Footer from '../components/astro/Footer.astro';
import { ui } from '../i18n/ui';

import logoHeader from '../assets/logo.png';

interface Props {
  title: string;
  lang: keyof typeof ui;
}

const { title, lang } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;500;700&family=Fraunces:opsz,wght@9..144,400;500;600&family=Newsreader:opsz,wght@6..72,400;500;600&display=swap" rel="stylesheet" />
    
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <title>{title} | Tita Cosi</title>

    <style is:global>
      /* Aseguramos la renderización correcta de los iconos en toda la app */
      .material-symbols-outlined {
        font-family: 'Material Symbols Outlined';
        font-weight: normal;
        font-style: normal;
        font-size: 24px;
        line-height: 1;
        letter-spacing: normal;
        text-transform: none;
        display: inline-block;
        white-space: nowrap;
        word-wrap: normal;
        direction: ltr;
        -webkit-font-feature-settings: 'liga';
        -webkit-font-smoothing: antialiased;
      }
    </style>
  </head>
  <body class="bg-titacosi-base text-titacosi-primary font-sans antialiased selection:bg-titacosi-accent selection:text-titacosi-surface flex flex-col min-h-screen">
    
    <Header currentLang={lang} logo={logoHeader} client:load />

    <main class="grow">
      <slot />
    </main>

    <Footer lang={lang} />

    <script>
      import Lenis from 'lenis';

      const lenis = new Lenis({
        autoRaf: true,
      });
    </script>
  </body>
</html>