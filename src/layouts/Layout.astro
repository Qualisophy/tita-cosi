---
// src/layouts/Layout.astro
import '../styles/global.css';

import Header from '../components/react/shared/Header';
import Footer from '../components/astro/Footer.astro';
import WhatsAppButton from '../components/astro/WhatsAppButton.astro'; // NUEVO IMPORT
import { ui } from '../i18n/ui';

import logoHeader from '../assets/logo-header.png';

interface Props {
  title: string;
  lang: keyof typeof ui;
}

const { title, lang } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/ico+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;500;700&family=Fraunces:opsz,wght@9..144,400;500;600&family=Newsreader:opsz,wght@6..72,400;500;600&display=swap" rel="stylesheet" />
    
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <title>{title} | Tita Cosi</title>

    <style is:global>
      .material-symbols-outlined {
        font-family: 'Material Symbols Outlined';
        font-weight: normal;
        font-style: normal;
        font-size: 24px;
        line-height: 1;
        letter-spacing: normal;
        text-transform: none;
        display: inline-block;
        white-space: nowrap;
        word-wrap: normal;
        direction: ltr;
        -webkit-font-feature-settings: 'liga';
        -webkit-font-smoothing: antialiased;
      }
    </style>

    <script id="cookieyes" type="text/javascript" src="https://cdn-cookieyes.com/client_data/0543345d60a4116d3d5d11a57e497d7b/script.js"></script> 
    </head>
  <body class="bg-titacosi-base text-titacosi-primary font-sans antialiased selection:bg-titacosi-accent selection:text-titacosi-surface flex flex-col min-h-screen">
    
    <Header 
      client:load 
      currentLang={lang} 
      logo={logoHeader} 
      currentPath={Astro.url.pathname} 
    />
    
    <main class="grow">
      <slot />
    </main>

    <WhatsAppButton />

    <div id="site-footer" class="relative z-30">
      <Footer lang={lang} />
    </div>

    <script>
      import Lenis from 'lenis';

      const lenis = new Lenis({
        autoRaf: true,
      });
    </script>

    {/* SCRIPT MODIFICADO PARA REBOTAR AMBOS BOTONES */}
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const checkFooterCollision = () => {
          const footer = document.getElementById("site-footer");
          const cookieBtn = document.querySelector(".cky-btn-revisit-wrapper");
          const whatsappBtn = document.getElementById("whatsapp-floating-btn"); // AÑADIDO
          const enrollBtn = document.getElementById("floating-enroll-btn");
          
          if (footer) {
            const footerRect = footer.getBoundingClientRect();
            const windowHeight = window.innerHeight;
            
            // 32px (bottom-8) es la altura base de Tailwind que pusimos en el componente
            let newBottom = 32; 
            const overlap = windowHeight - footerRect.top;
            
            if (overlap > 0) {
              newBottom = overlap + 32;
            }

            // Si hay botón de reservas móvil interfiriendo
            if (enrollBtn && window.innerWidth < 1024) {
               const enrollBtnHeight = enrollBtn.offsetHeight || 48;
               newBottom += (enrollBtnHeight + 12);
            }
            
            // Aplicar rebote al botón de cookies
            if (cookieBtn) {
              cookieBtn.style.setProperty("bottom", `${newBottom}px`, "important");
              cookieBtn.style.setProperty("left", "16px", "important");
              cookieBtn.style.setProperty("z-index", "999", "important");
            }

            // Aplicar rebote al botón de WhatsApp
            if (whatsappBtn) {
              whatsappBtn.style.setProperty("bottom", `${newBottom}px`, "important");
            }
          }
        };

        const waitForElements = setInterval(() => {
          const cookieBtn = document.querySelector(".cky-btn-revisit-wrapper");
          const whatsappBtn = document.getElementById("whatsapp-floating-btn");
          
          if (cookieBtn || whatsappBtn) {
            checkFooterCollision();
            window.addEventListener("scroll", checkFooterCollision, { passive: true });
            window.addEventListener("resize", checkFooterCollision, { passive: true });
            if (cookieBtn) clearInterval(waitForElements); 
          }
        }, 300);

        setTimeout(() => clearInterval(waitForElements), 10000);
      });
    </script>

  </body>
</html>