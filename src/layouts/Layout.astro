---
// src/layouts/Layout.astro
import '../styles/global.css';

import Header from '../components/react/shared/Header';
import Footer from '../components/astro/Footer.astro';
import { ui } from '../i18n/ui';

interface Props {
  title: string;
  lang: keyof typeof ui;
}

const { title, lang } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <title>{title} | Tita Cosi</title>
  </head>
  <body class="bg-titacosi-base text-titacosi-primary font-sans antialiased selection:bg-titacosi-accent selection:text-titacosi-surface flex flex-col min-h-screen">
    
    <Header currentLang={lang} client:load />

    <main class="grow pt-20">
      <slot />
    </main>

    <Footer lang={lang} />

    <script>
      import Lenis from 'lenis';

      const lenis = new Lenis({
        autoRaf: true,
      });
    </script>
  </body>
</html>